# Mini Jarvis — Offline Configuration
# All processing runs locally — no internet required after setup.

# ── Network ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
AUTH_TOKEN=
SAMPLE_RATE=16000

# ── VAD (Voice Activity Detection) ─────────────────────────────────────────────
ENERGY_THRESHOLD=280
MIN_SPEECH_MS=350
SILENCE_HOLD_MS=900
MAX_SPEECH_MS=10000
PRE_ROLL_MS=250
ADAPTIVE_VAD=true
NOISE_FLOOR_ALPHA=0.02
VAD_MULTIPLIER=3.2
RESPONSE_COOLDOWN_MS=600

# ── Wake word ──────────────────────────────────────────────────────────────────
WAKE_WORD=jarvis
REQUIRE_WAKE_WORD=false
WAKE_ALIASES=

# ── STT (Local Whisper — offline) ──────────────────────────────────────────────
STT_PROVIDER=local
WHISPER_MODEL=tiny.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# ── LLM (Ollama — offline) ─────────────────────────────────────────────────────
USE_OLLAMA_CHAT=true
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# ── TTS (pyttsx3 — offline) ────────────────────────────────────────────────────
TTS_PROVIDER=local

# ── HUD ────────────────────────────────────────────────────────────────────────
ENABLE_HUD=true
ASYNC_TTS=true
BARGE_IN=true

# ── Filtering ──────────────────────────────────────────────────────────────────
IGNORE_SHORT_TRANSCRIPTS=true
MIN_TRANSCRIPT_CHARS=4
MAX_CHAT_HISTORY=8

# ── Debug ──────────────────────────────────────────────────────────────────────
AUDIO_DEBUG=true
DEBUG_EVERY_MS=1500

# DC blocking
ENABLE_DCBLOCK=true
DCBLOCK_R=0.995
PCM_INT32_GAIN_DIV=1
