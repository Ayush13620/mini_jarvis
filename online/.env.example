# Mini Jarvis — Online (Cloud-First) Configuration
# Uses Groq for STT/LLM and Edge-TTS for natural voice — requires internet.

# ── Network ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
AUTH_TOKEN=
SAMPLE_RATE=16000

# ── VAD ────────────────────────────────────────────────────────────────────────
ENERGY_THRESHOLD=280
MIN_SPEECH_MS=350
SILENCE_HOLD_MS=900
MAX_SPEECH_MS=10000
PRE_ROLL_MS=250
ADAPTIVE_VAD=true
NOISE_FLOOR_ALPHA=0.02
VAD_MULTIPLIER=3.2
RESPONSE_COOLDOWN_MS=600

# ── Wake word ──────────────────────────────────────────────────────────────────
WAKE_WORD=jarvis
REQUIRE_WAKE_WORD=false
WAKE_ALIASES=

# ── STT (Groq Cloud — fast, free tier) ─────────────────────────────────────────
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3

# ── LLM (Groq Cloud) ───────────────────────────────────────────────────────────
USE_OLLAMA_CHAT=false
GROQ_MODEL=llama-3.3-70b-versatile
# Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── TTS (Microsoft Edge Neural — free, natural voice) ─────────────────────────
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-ChristopherNeural

# ── HUD ────────────────────────────────────────────────────────────────────────
ENABLE_HUD=true
ASYNC_TTS=true
BARGE_IN=true

# ── Filtering ──────────────────────────────────────────────────────────────────
IGNORE_SHORT_TRANSCRIPTS=true
MIN_TRANSCRIPT_CHARS=4
MAX_CHAT_HISTORY=8

# ── Debug ──────────────────────────────────────────────────────────────────────
AUDIO_DEBUG=true
DEBUG_EVERY_MS=1500

# DC blocking
ENABLE_DCBLOCK=true
DCBLOCK_R=0.995
PCM_INT32_GAIN_DIV=1
